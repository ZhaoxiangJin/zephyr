config NXP_POWER_RAIL
	bool
	help
	  Selected by concrete NXP power-rail controller drivers (PMC,
	  SLEEPCON).

config NXP_PMC_POWER_RAIL
	bool "NXP PMC power-rail controller driver"
	default y
	depends on DT_HAS_NXP_PMC_POWER_RAIL_CONTROLLER_ENABLED
	select NXP_POWER_RAIL
	help
	  Enable the NXP PMC power-rail controller driver. The driver
	  operates on the ``PDRUNCFGn`` staging registers and commits
	  changes via ``CTRL.APPLYCFG``.

config NXP_SLEEPCON_POWER_RAIL
	bool "NXP SLEEPCON power-rail controller driver"
	default y
	depends on DT_HAS_NXP_SLEEPCON_POWER_RAIL_CONTROLLER_ENABLED
	select NXP_POWER_RAIL
	help
	  Enable the NXP SLEEPCON power-rail controller driver. The driver
	  operates on the single ``RUNCFG`` register through its
	  write-to-set / write-to-clear aliases.

if NXP_POWER_RAIL

config NXP_POWER_RAIL_INIT_PRIORITY
	int "NXP power-rail controller init priority"
	default 35
	help
	  Initialization priority for the power-rail controllers. Must run
	  earlier than any peripheral driver that consumes a power rail.

endif # NXP_POWER_RAIL
